{
	"activationEvents": [
		"onCommand:onedrive-browser.openOneDrive",
		"onFileSystem:onedrive"
	],
	"author": {
		"email": "Source/Open@Editor.Land",
		"name": "Source 🖋️ Open 👐🏻",
		"url": "HTTPS://Editor.Land"
	},
	"browser": "./dist/web/extension.js",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/LandOnedriveBrowser/issues"
	},
	"contributes": {
		"commands": [
			{
				"command": "onedrive-browser.openOneDrive",
				"title": "Open OneDrive Folder"
			}
		],
		"webOpener": {
			"import": "webOpener.js",
			"scheme": "onedrive"
		}
	},
	"dependencies": {},
	"description": "Browse and edit files from OneDrive in VS Code",
	"devDependencies": {
		"@playform/build": "0.2.3",
		"assert": "2.1.0",
		"process": "0.11.10",
		"ts-loader": "9.5.2"
	},
	"displayName": "OneDrive Browser",
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/LandOnedriveBrowser#readme",
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"license": "SEE LICENSE IN LICENSE",
	"name": "onedrive-browser",
	"preview": true,
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/LandOnedriveBrowser.git"
	},
	"scripts": {
		"compile-web": "webpack",
		"package-web": "webpack --mode production --devtool hidden-source-map",
		"prepublishOnly": "Build 'Source/**/*.ts'",
		"run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. .",
		"watch-web": "webpack --watch"
	},
	"type": "module",
	"version": "0.0.1"
}
